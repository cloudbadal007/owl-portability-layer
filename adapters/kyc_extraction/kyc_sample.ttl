@prefix kyc: <https://example-bank.com/ontology/kyc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example-bank.com/ontology/kyc> a owl:Ontology ;
    rdfs:label "KYC Compliance Ontology — sample fragment" ;
    rdfs:comment "Generated by owl-portability-layer kyc_extraction adapter. See Medium article for full extraction pipeline." .

kyc:Customer a owl:Class ;
    rdfs:comment "A natural or legal person onboarded as a bank customer" .

kyc:LegalEntity a owl:Class ;
    rdfs:subClassOf kyc:Customer ;
    rdfs:comment "A corporate, trust, or partnership customer" .

kyc:BeneficialOwner a owl:Class ;
    rdfs:comment "A natural person who ultimately owns or controls a legal entity" .

kyc:PEP a owl:Class ;
    rdfs:subClassOf kyc:Customer ;
    rdfs:comment "Politically Exposed Person — holds or held a prominent public position" .

kyc:RiskTier a owl:Class ;
    owl:equivalentClass [
        a rdfs:Datatype ;
        owl:oneOf ( "LOW" "MEDIUM" "HIGH" "PEP" )
    ] .

kyc:hasRiskTier a owl:FunctionalProperty , owl:ObjectProperty ;
    rdfs:domain kyc:Customer ;
    rdfs:range  kyc:RiskTier .

kyc:hasBeneficialOwner a owl:ObjectProperty ;
    rdfs:domain kyc:LegalEntity ;
    rdfs:range  kyc:BeneficialOwner .

kyc:ownershipPercentage a owl:DatatypeProperty ;
    rdfs:domain kyc:BeneficialOwner ;
    rdfs:range  [ owl:onDatatype xsd:decimal ;
                  owl:withRestrictions (
                      [ xsd:minInclusive "0.0"^^xsd:decimal ]
                      [ xsd:maxInclusive "100.0"^^xsd:decimal ]
                  ) ] .

kyc:ReviewObligation a owl:Class ;
    rdfs:comment "A periodic review that must be completed for a customer" .

kyc:requiresReview a owl:ObjectProperty ;
    rdfs:domain kyc:Customer ;
    rdfs:range  kyc:ReviewObligation .

kyc:reviewIntervalMonths a owl:DatatypeProperty ;
    rdfs:domain kyc:ReviewObligation ;
    rdfs:range  xsd:integer ;
    rdfs:comment "HIGH risk = 12 months, PEP = 12 months regardless of risk tier" .

# <!-- ASSUMPTION: annual review for PEP derived from Confluence §4.3 -->
kyc:PEPReviewObligation a owl:Class ;
    rdfs:subClassOf kyc:ReviewObligation ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty kyc:reviewIntervalMonths ;
        owl:hasValue "12"^^xsd:integer
    ] .
